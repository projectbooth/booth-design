{
  "name": "@projectbooth/design-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared presentational primitives from booth-design's own component library, published so other @projectbooth/*-ui modules can depend on them instead of re-implementing the same pattern per module. v0: Tooltip/HelpHint only. See README.md for what a consuming module has to do with it.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/projectbooth/booth-design.git",
    "directory": "design-ui"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "sync": "node scripts/sync-source.mjs",
    "build": "npm run sync && vite build && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@radix-ui/react-tooltip": "^1.2.16"
  },
  "devDependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
